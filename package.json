{
  "name": "curio-chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "读取当前网页并围绕网页内容进行多轮对话的 Chrome 侧边栏扩展。",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node scripts/validate.mjs",
    "build": "npm run check && vite build",
    "package": "npm run build && sh scripts/package.sh"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
