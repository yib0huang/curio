{
  "manifest_version": 3,
  "name": "Curio - 网页对话助手",
  "version": "0.1.0",
  "description": "读取当前网页，并围绕网页内容进行多轮对话。",
  "icons": {
    "16": "assets/icons-v3/icon-16.png",
    "32": "assets/icons-v3/icon-32.png",
    "48": "assets/icons-v3/icon-48.png",
    "128": "assets/icons-v3/icon-128.png"
  },
  "permissions": ["activeTab", "sidePanel", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Curio",
    "default_icon": {
      "16": "assets/icons-v3/icon-16.png",
      "32": "assets/icons-v3/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
